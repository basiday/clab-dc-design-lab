# leaf-2

auto lo
iface lo inet loopback
    address 10.255.1.2/32
    vxlan-local-tunnelip 10.255.1.2

auto mgmt
iface mgmt
    address 127.0.0.1/8
    address 127.0.1.1/8
    address ::1/128
    vrf-table auto

auto eth0
iface eth0 inet dhcp
    ip-forward off
    ip6-forward off
    vrf mgmt

auto swp1
iface swp1
    alias to spine-1:swp2
    address 10.0.1.3/31
    mtu 9216

auto swp2
iface swp2
    alias to spine-2:swp2
    address 10.0.2.3/31
    mtu 9216

####

auto swp4
iface swp4
    alias cl1-h2:eth1
    mtu 9000

auto bond1
iface bond1
    bond-slaves swp4
    bond-mode 802.3ad
    bond-lacp-rate 1
    bond-lacp-bypass-allow no
    es-sys-mac 44:38:39:ff:00:01
    bridge-access 20
    mtu 9000
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto swp5
iface swp5
    alias h5
    mtu 9000
    bridge-access 120
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto br_default
iface br_default
    bridge-ports bond1 swp5
    bridge-vlan-aware yes
    bridge-vids 10 20 110 120
    bridge-pvid 1
    mtu 9000
