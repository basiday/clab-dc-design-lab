# spine-1

auto lo
iface lo inet loopback
    address 10.255.0.1/32

auto mgmt
iface mgmt
    address 127.0.0.1/8
    address 127.0.1.1/8
    address ::1/128
    vrf-table auto

auto eth0
iface eth0 inet dhcp
    ip-forward off
    ip6-forward off
    vrf mgmt

auto swp1
iface swp1
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias to leaf-1:swp1
    address 10.0.1.0/31
    mtu 9216

auto swp2
iface swp2
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias to leaf-2:swp1
    address 10.0.1.2/31
    mtu 9216

auto swp3
iface swp3
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias to leaf-3:swp1
    address 10.0.1.4/31
    mtu 9216

auto swp4
iface swp4
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias to leaf-4:swp1
    address 10.0.1.6/31
    mtu 9216
