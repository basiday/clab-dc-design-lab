# leaf-4 

auto lo
iface lo inet loopback
    address 10.255.1.4/32
    vxlan-local-tunnelip 10.255.1.4
    clagd-vxlan-anycast-ip 10.255.2.34

auto mgmt
iface mgmt
    address 127.0.0.1/8
    address 127.0.1.1/8
    address ::1/128
    vrf-table auto

auto eth0
iface eth0 inet dhcp
    ip-forward off
    ip6-forward off
    vrf mgmt

auto swp1
iface swp1
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias to spine-1:swp4
    address 10.0.1.7/31
    mtu 9216

auto swp2
iface swp2
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias to spine-2:swp4
    address 10.0.2.7/31
    mtu 9216

# --- mlag peerlink ---
auto swp10
iface swp10
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias peerlink to leaf-3:swp10
    mtu 9216

auto swp11
iface swp11
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias peerlink to leaf-3:swp11
    mtu 9216

auto peerlink
iface peerlink
    bond-slaves swp10 swp11
    bond-mode 802.3ad
    bond-lacp-rate 1
    mtu 9216

auto peerlink.4094
iface peerlink.4094
    clagd-peer-ip linklocal
    clagd-backup-ip 10.255.1.3
    clagd-sys-mac 44:38:39:ff:01:34
    clagd-priority 2000
    mtu 9216

#####

auto swp4
iface swp4
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias cl1-h4:eth2
    mtu 9000

auto bond1
iface bond1
    bond-slaves swp4
    bond-mode 802.3ad
    bond-lacp-rate 1
    bond-lacp-bypass-allow no
    clag-id 1
    bridge-access 20
    mtu 9000
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto swp5
iface swp5
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias cl2-h4:eth1
    mtu 9000
    bridge-access 120
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto br_default
iface br_default
    bridge-ports bond1 peerlink swp5 vxlan4094
    bridge-vlan-aware yes
    bridge-vids 10 20 110 120 4001 4002
    bridge-pvid 1
    mtu 9000

auto vxlan4094
iface vxlan4094
    bridge-vlan-vni-map 10=10010 20=10020 110=10110 120=10120 4001=4001 4002=4002
    bridge-vids 10 20 110 120 4001 4002
    bridge-learning off
    bridge-arp-nd-suppress on
    mtu 9000
    # DSCP внутреннего пакета копируется во внешний IP-заголовок VXLAN
    # (vxlan-tos ifupdown2 для SVD не применяет, ставим явно)
    post-up ip link set dev vxlan4094 type vxlan tos inherit

auto VRF-CL1
iface VRF-CL1
    vrf-table auto

auto VRF-CL2
iface VRF-CL2
    vrf-table auto

auto vlan10
iface vlan10
    alias VRF-CL1 10
    address 10.10.10.254/24
    address-virtual 00:00:5e:00:01:01 10.10.10.1/24
    vrf VRF-CL1
    vlan-raw-device br_default
    vlan-id 10
    mtu 9000

auto vlan20
iface vlan20
    alias VRF-CL1 20
    address 10.10.20.254/24
    address-virtual 00:00:5e:00:01:01 10.10.20.1/24
    vrf VRF-CL1
    vlan-raw-device br_default
    vlan-id 20
    mtu 1500

auto vlan110
iface vlan110
    alias VRF-CL2 110
    address 10.10.10.254/24
    address-virtual 00:00:5e:00:01:01 10.10.10.1/24
    vrf VRF-CL2
    vlan-raw-device br_default
    vlan-id 110
    mtu 1500

auto vlan120
iface vlan120
    alias VRF-CL2 120
    address 10.10.20.254/24
    address-virtual 00:00:5e:00:01:01 10.10.20.1/24
    vrf VRF-CL2
    vlan-raw-device br_default
    vlan-id 120
    mtu 1500

auto vlan4001
iface vlan4001
    alias L3VNI VRF-CL1
    hwaddress 44:38:39:ff:01:34
    vrf VRF-CL1
    vlan-raw-device br_default
    vlan-id 4001
    mtu 9000

auto vlan4002
iface vlan4002
    alias L3VNI VRF-CL2
    hwaddress 44:38:39:ff:01:34
    vrf VRF-CL2
    vlan-raw-device br_default
    vlan-id 4002
    mtu 9000
