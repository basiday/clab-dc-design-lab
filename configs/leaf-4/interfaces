# leaf-4 

auto lo
iface lo inet loopback
    address 10.255.1.4/32
    vxlan-local-tunnelip 10.255.1.4

auto mgmt
iface mgmt
    address 127.0.0.1/8
    address 127.0.1.1/8
    address ::1/128
    vrf-table auto

auto eth0
iface eth0 inet dhcp
    ip-forward off
    ip6-forward off
    vrf mgmt

auto swp1
iface swp1
    alias to spine-1:swp4
    address 10.0.1.7/31
    mtu 9216

auto swp2
iface swp2
    alias to spine-2:swp4
    address 10.0.2.7/31
    mtu 9216

# --- mlag peerlink ---
auto swp10
iface swp10
    alias peerlink to leaf-3:swp10
    mtu 9216

auto swp11
iface swp11
    alias peerlink to leaf-3:swp11
    mtu 9216

auto peerlink
iface peerlink
    bond-slaves swp10 swp11
    bond-mode 802.3ad
    bond-lacp-rate 1
    mtu 9216

auto peerlink.4094
iface peerlink.4094
    clagd-peer-ip linklocal
    clagd-backup-ip 10.255.1.3
    clagd-sys-mac 44:38:39:ff:01:34
    clagd-priority 2000
    mtu 9216

#####

auto swp4
iface swp4
    alias cl1-h4:eth2
    mtu 9000

auto bond1
iface bond1
    bond-slaves swp4
    bond-mode 802.3ad
    bond-lacp-rate 1
    bond-lacp-bypass-allow no
    clag-id 1
    bridge-access 20
    mtu 9000
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto swp5
iface swp5
    alias cl2-h4:eth1
    mtu 9000
    bridge-access 120
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto br_default
iface br_default
    bridge-ports bond1 peerlink swp5
    bridge-vlan-aware yes
    bridge-vids 10 20 110 120
    bridge-pvid 1
    mtu 9000
