# leaf-3

auto lo
iface lo inet loopback
    address 10.255.1.3/32
    vxlan-local-tunnelip 10.255.1.3

auto mgmt
iface mgmt
    address 127.0.0.1/8
    address 127.0.1.1/8
    address ::1/128
    vrf-table auto

auto eth0
iface eth0 inet dhcp
    ip-forward off
    ip6-forward off
    vrf mgmt

auto swp1
iface swp1
    alias to spine-1:swp3
    address 10.0.1.5/31
    mtu 9216

auto swp2
iface swp2
    alias to spine-2:swp3
    address 10.0.2.5/31
    mtu 9216

# --- mlag peerlink ---
auto swp10
iface swp10
    alias peerlink to leaf-4:swp10
    mtu 9216

auto swp11
iface swp11
    alias peerlink to leaf-4:swp11
    mtu 9216

auto peerlink
iface peerlink
    bond-slaves swp10 swp11
    bond-mode 802.3ad
    bond-lacp-rate 1
    mtu 9216

auto peerlink.4094
iface peerlink.4094
    clagd-peer-ip linklocal
    clagd-backup-ip 10.255.1.4
    clagd-sys-mac 44:38:39:ff:01:34
    clagd-priority 1000
    mtu 9216

#### 

auto swp3
iface swp3
    alias cl1-h3:eth1
    mtu 9000
    bridge-vids 10
    bridge-allow-untagged no
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto swp4
iface swp4
    alias cl1-h4:eth1
    mtu 9000

auto bond1
iface bond1
    bond-slaves swp4
    bond-mode 802.3ad
    bond-lacp-rate 1
    bond-lacp-bypass-allow no
    clag-id 1
    bridge-access 20
    mtu 9000
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto swp5
iface swp5
    alias cl2-h3:eth1
    mtu 9000
    bridge-access 110
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto br_default
iface br_default
    bridge-ports bond1 peerlink swp3 swp5 vxlan4094
    bridge-vlan-aware yes
    bridge-vids 10 20 110 120
    bridge-pvid 1
    mtu 9000

auto vxlan4094
iface vxlan4094
    bridge-vlan-vni-map 10=10010 20=10020 110=10110 120=10120
    bridge-vids 10 20 110 120
    bridge-learning off
    bridge-arp-nd-suppress on
    mtu 9000
