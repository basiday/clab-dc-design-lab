# leaf-1

auto lo
iface lo inet loopback
    address 10.255.1.1/32
    vxlan-local-tunnelip 10.255.1.1

auto mgmt
iface mgmt
    address 127.0.0.1/8
    address 127.0.1.1/8
    address ::1/128
    vrf-table auto

auto eth0
iface eth0 inet dhcp
    ip-forward off
    ip6-forward off
    vrf mgmt

auto swp1
iface swp1
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias to spine-1:swp1
    address 10.0.1.1/31
    mtu 9216

auto swp2
iface swp2
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias to spine-2:swp1
    address 10.0.2.1/31
    mtu 9216

####

auto swp3
iface swp3
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias cl1-h1:eth1
    mtu 9000
    bridge-vids 10
    bridge-allow-untagged no
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto swp4
iface swp4
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias cl1-h2:eth1
    mtu 9000

auto bond1
iface bond1
    bond-slaves swp4
    bond-mode 802.3ad
    bond-lacp-rate 1
    bond-lacp-bypass-allow no
    es-sys-mac 44:38:39:ff:00:01
    bridge-access 20
    mtu 9000
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

auto swp5
iface swp5
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias cl2-h1:eth1
    mtu 9000
    bridge-access 110
    mstpctl-portadminedge yes
    mstpctl-bpduguard yes

# --- border: bgw ---
auto swp6
iface swp6
    post-up /usr/local/sbin/fabric-qos.sh $IFACE
    alias border to bgw:eth1
    mtu 9216

auto swp6.101
iface swp6.101
    alias bgw VRF-CL1
    address 172.16.1.0/31
    vrf VRF-CL1
    mtu 1500

auto swp6.102
iface swp6.102
    alias bgw VRF-CL2
    address 172.16.2.0/31
    vrf VRF-CL2
    mtu 1500

auto br_default
iface br_default
    bridge-ports bond1 swp3 swp5 vxlan4094
    bridge-vlan-aware yes
    bridge-vids 10 20 110 120 4001 4002
    bridge-pvid 1
    mtu 9000

auto vxlan4094
iface vxlan4094
    bridge-vlan-vni-map 10=10010 20=10020 110=10110 120=10120 4001=4001 4002=4002
    bridge-vids 10 20 110 120 4001 4002
    bridge-learning off
    bridge-arp-nd-suppress on
    mtu 9000
    # DSCP внутреннего пакета копируется во внешний IP-заголовок VXLAN
    # (vxlan-tos ifupdown2 для SVD не применяет, ставим явно)
    post-up ip link set dev vxlan4094 type vxlan tos inherit

auto VRF-CL1
iface VRF-CL1
    vrf-table auto

auto VRF-CL2
iface VRF-CL2
    vrf-table auto

auto vlan10
iface vlan10
    alias VRF-CL1 10
    address 10.10.10.251/24
    address-virtual 00:00:5e:00:01:01 10.10.10.1/24
    vrf VRF-CL1
    vlan-raw-device br_default
    vlan-id 10
    mtu 9000

auto vlan20
iface vlan20
    alias VRF-CL1 20
    address 10.10.20.251/24
    address-virtual 00:00:5e:00:01:01 10.10.20.1/24
    vrf VRF-CL1
    vlan-raw-device br_default
    vlan-id 20
    mtu 1500

auto vlan110
iface vlan110
    alias VRF-CL2 110
    address 10.10.10.251/24
    address-virtual 00:00:5e:00:01:01 10.10.10.1/24
    vrf VRF-CL2
    vlan-raw-device br_default
    vlan-id 110
    mtu 1500

auto vlan120
iface vlan120
    alias VRF-CL2 120
    address 10.10.20.251/24
    address-virtual 00:00:5e:00:01:01 10.10.20.1/24
    vrf VRF-CL2
    vlan-raw-device br_default
    vlan-id 120
    mtu 1500

auto vlan4001
iface vlan4001
    alias L3VNI VRF-CL1
    vrf VRF-CL1
    vlan-raw-device br_default
    vlan-id 4001
    mtu 9000

auto vlan4002
iface vlan4002
    alias L3VNI VRF-CL2
    vrf VRF-CL2
    vlan-raw-device br_default
    vlan-id 4002
    mtu 9000
